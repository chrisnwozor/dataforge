# Required to save SQL login passwords and execute loads.
# Generate a value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATAFORGE_SECRET=

# Optional: app-side mounted folder corresponding to SQL Server's staging folder.
# DATAFORGE_STAGING_WRITE_DIR=/mnt/sql-staging

# Optional: per-batch timeout in milliseconds (default 10 minutes).
DATAFORGE_BATCH_TIMEOUT_MS=600000

# Optional: keep SQLite/uploads somewhere other than ./data.
# DATAFORGE_DATA_DIR=/absolute/path/to/data
