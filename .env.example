# Public canonical origin. Use your real HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional address displayed publicly. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Required in production: generate a random secret with at least 32 characters.
# Used to sign short-lived, connection-bound form tokens. Never prefix with NEXT_PUBLIC_.
CONTACT_TOKEN_SECRET=

# Resend: verify the sender domain before enabling delivery. Use bare email addresses.
# All three are required together. Missing delivery is an explicit local-only no-op;
# production returns a safe error and never reports delivery success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Required in production for distributed rate limiting and atomic replay protection.
# Development without these uses bounded process-local memory (unsuitable for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional spam protection. Set both keys together; recommended in production.
# The widget action must be "contact" and its hostname must match this website.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Vercel's protected forwarding header is trusted automatically.
# Other hosts: set true ONLY behind a proxy that replaces incoming X-Forwarded-For.
# Without a trusted proxy all visitors share a conservative connection rate limit.
CONTACT_TRUST_PROXY=false
