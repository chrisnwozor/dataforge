# Required to save SQL login passwords and execute loads.
# Generate a value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATAFORGE_SECRET=

# Optional: app-side mounted folder corresponding to SQL Server's staging folder.
# DATAFORGE_STAGING_WRITE_DIR=/mnt/sql-staging

# Optional: per-batch timeout in milliseconds (default 10 minutes).
DATAFORGE_BATCH_TIMEOUT_MS=600000

# Optional: keep SQLite/uploads somewhere other than ./data.
# DATAFORGE_DATA_DIR=/absolute/path/to/data

# Accounts are enabled by default. Development-only compatibility mode:
# DATAFORGE_AUTH=off
DATAFORGE_AUTH=on
# Production requires the exact public HTTPS origin (also used for email links/CSRF).
DATAFORGE_APP_URL=http://localhost:3000

# Development without SMTP prints branded email links to the server console.
# Production requires SMTP; messages use STARTTLS unless SECURE=true (TLS on connect).
# DATAFORGE_SMTP_HOST=smtp.example.com
# DATAFORGE_SMTP_PORT=587
# DATAFORGE_SMTP_SECURE=false
# DATAFORGE_SMTP_USER=
# DATAFORGE_SMTP_PASSWORD=
# DATAFORGE_EMAIL_FROM=DataForge <no-reply@example.com>

# Workspace SQL passwords use HKDF-derived AES-256-GCM keys.
DATAFORGE_SECRET_KEY_ID=primary
# During rotation only: a JSON map from previous key ids to their original secrets.
# DATAFORGE_SECRET_PREVIOUS_KEYS={"primary":"OLD_32_BYTE_BASE64_KEY"}

# Enable ONLY behind a trusted proxy that overwrites X-Forwarded-For.
# DATAFORGE_TRUST_PROXY=true
