exports[`parameterized SQL expression compilation > snapshots scalar > scalar 1`] = `
{
  "dependencies": [
    "total-sales",
    "total-profit",
  ],
  "params": [
    {
      "name": "p0",
      "type": "number",
      "value": 100,
    },
    {
      "name": "p1",
      "type": "boolean",
      "value": true,
    },
    {
      "name": "p2",
      "type": "number",
      "value": 2,
    },
  ],
  "sql": "SELECT (CASE WHEN ((NOT ((SELECT SUM(CAST([f].[Sales] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f]) > @p0)) AND (@p1 = CAST(1 AS BIT))) THEN ROUND(ABS((SELECT SUM(CAST([f].[Profit] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f])), @p2) ELSE NULL END) AS [value];",
}
`;

