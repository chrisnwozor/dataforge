exports[`parameterized SQL expression compilation > snapshots calculateIn > calculateIn 1`] = `
{
  "dependencies": [
    "total-sales",
  ],
  "params": [
    {
      "name": "p0",
      "type": "string",
      "value": "Office",
    },
    {
      "name": "p1",
      "type": "string",
      "value": "Furniture",
    },
    {
      "name": "p2",
      "type": "number",
      "value": 2,
    },
  ],
  "sql": "SELECT (SELECT SUM(CAST([f].[Sales] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f]
LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[ProductKey] = [d0].[product_key]
WHERE (([d0].[Category] IN (@p0, @p1) OR [d0].[Category] IS NULL)) AND (([f].[Quantity] >= @p2))) AS [value];",
}
`;

exports[`parameterized SQL expression compilation > snapshots divide > divide 1`] = `
{
  "dependencies": [
    "total-profit",
    "total-sales",
  ],
  "params": [
    {
      "name": "p0",
      "type": "number",
      "value": 0,
    },
  ],
  "sql": "SELECT (CASE WHEN (SELECT SUM(CAST([f].[Sales] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f]) IS NULL OR (SELECT SUM(CAST([f].[Sales] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f]) = 0 THEN @p0 ELSE CAST((SELECT SUM(CAST([f].[Profit] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f]) AS FLOAT) / NULLIF((SELECT SUM(CAST([f].[Sales] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f]), 0) END) AS [value];",
}
`;

