exports[`parameterized SQL expression compilation > snapshots aggregations > aggregations 1`] = `
{
  "dependencies": [],
  "params": [],
  "sql": "SELECT (((((((SELECT SUM(CAST([f].[Sales] AS DECIMAL(38, 10)))
FROM [dw].[fact_sales] AS [f]) + (SELECT AVG(CAST([f].[Profit] AS FLOAT))
FROM [dw].[fact_sales] AS [f])) + (SELECT MIN([f].[Sales])
FROM [dw].[fact_sales] AS [f])) + (SELECT MAX([f].[Quantity])
FROM [dw].[fact_sales] AS [f])) + (SELECT COUNT_BIG([f].[Order ID])
FROM [dw].[fact_sales] AS [f])) + (SELECT COUNT_BIG(DISTINCT [f].[Order ID])
FROM [dw].[fact_sales] AS [f])) + (SELECT COUNT_BIG(*)
FROM [dw].[fact_sales] AS [f])) AS [value];",
}
`;

exports[`parameterized SQL expression compilation > snapshots calculate > calculate 1`] = `
