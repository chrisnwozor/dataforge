  [__df_d1].[v] AS [m1]
INTO [#df_result]
FROM [#df_groups] AS [g]

CROSS APPLY (VALUES ([g].[__df_v0])) AS [__df_d0] ([v])
CROSS APPLY (VALUES ([g].[__df_v1])) AS [__df_d1] ([v]);
SELECT TOP (@__df_limit) [r].[m0], [r].[m1]
FROM [#df_result] AS [r];
