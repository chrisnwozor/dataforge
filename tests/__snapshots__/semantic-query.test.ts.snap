// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`semantic query expressions and context > applies DIVIDE's alternate only for a null or zero denominator, preserving a null numerator 1`] = `
"WITH [__df_result] AS (
  SELECT (CASE WHEN @p1 IS NULL OR @p1 = 0 THEN @p2 ELSE CAST(@p0 AS FLOAT) / NULLIF(@p1, 0) END) AS [m0],
    COUNT_BIG(*) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
)
SELECT TOP (@__df_limit) [r].[m0]
FROM [__df_result] AS [r];"
`;

exports[`semantic query expressions and context > compiles MTD with calendar range joins and preserves non-date groups 1`] = `
"WITH [__df_base] AS (
  SELECT [d2].[Year] AS [c0],
    [d0].[category] AS [c1],
    [d1].[region] AS [c2],
    [d2].[Date] AS [c3],
    [f].[sales] AS [c4]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  LEFT JOIN [dw].[dim_date] AS [d2] ON [f].[date_key] = [d2].[DateKey]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1 AND [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], [b].[c1] AS [a1], MIN([b].[c3]) AS [__df_start], MAX([b].[c3]) AS [__df_end]
  FROM [__df_base] AS [b]
  WHERE [b].[c0] = @p0 AND [b].[c2] = @p1
  GROUP BY [b].[c0], [b].[c1]
),
[__df_result] AS (
  SELECT [g].[a0],
    [g].[a1],
    (SELECT SUM(CAST([b].[c4] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c2] = @p2 AND ([b].[c1] = [g].[a1] OR ([b].[c1] IS NULL AND [g].[a1] IS NULL)) AND [b].[c3] >= DATEFROMPARTS(YEAR([g].[__df_end]), MONTH([g].[__df_end]), 1) AND [b].[c3] <= [g].[__df_end]) AS [m0]
  FROM [__df_groups] AS [g]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC, [r].[a1] ASC;"
`;

exports[`semantic query expressions and context > compiles PREVIOUSPERIOD MONTH without interpolating the period request 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[Year] AS [c0],
    [d0].[Date] AS [c1],
    [f].[sales] AS [c2]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_date] AS [d0] ON [f].[date_key] = [d0].[DateKey]
  WHERE [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], MIN([b].[c1]) AS [__df_start], MAX([b].[c1]) AS [__df_end]
  FROM [__df_base] AS [b]
  GROUP BY [b].[c0]
),
[__df_result] AS (
  SELECT [g].[a0],
    (SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c1] >= DATEADD(MONTH, -1, DATEFROMPARTS(YEAR([g].[__df_end]), MONTH([g].[__df_end]), 1)) AND [b].[c1] <= DATEADD(DAY, -1, DATEFROMPARTS(YEAR([g].[__df_end]), MONTH([g].[__df_end]), 1))) AS [m0]
  FROM [__df_groups] AS [g]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query expressions and context > compiles PREVIOUSPERIOD QUARTER without interpolating the period request 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[Year] AS [c0],
    [d0].[Date] AS [c1],
    [f].[sales] AS [c2]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_date] AS [d0] ON [f].[date_key] = [d0].[DateKey]
  WHERE [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], MIN([b].[c1]) AS [__df_start], MAX([b].[c1]) AS [__df_end]
  FROM [__df_base] AS [b]
  GROUP BY [b].[c0]
),
[__df_result] AS (
  SELECT [g].[a0],
    (SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c1] >= DATEADD(QUARTER, -1, DATEFROMPARTS(YEAR([g].[__df_end]), ((MONTH([g].[__df_end]) - 1) / 3) * 3 + 1, 1)) AND [b].[c1] <= DATEADD(DAY, -1, DATEFROMPARTS(YEAR([g].[__df_end]), ((MONTH([g].[__df_end]) - 1) / 3) * 3 + 1, 1))) AS [m0]
  FROM [__df_groups] AS [g]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

