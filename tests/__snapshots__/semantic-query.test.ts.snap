LEFT JOIN [#df_agg] AS [d] ON [d].[__df_grain] = 2 AND 1 = 1 AND [d].[__df_date] >= DATEADD(QUARTER, -1, DATEFROMPARTS(YEAR([a].[__df_anchor0_end]), (DATEPART(QUARTER, [a].[__df_anchor0_end]) - 1) * 3 + 1, 1)) AND [d].[__df_date] <= DATEADD(DAY, -1, DATEFROMPARTS(YEAR([a].[__df_anchor0_end]), (DATEPART(QUARTER, [a].[__df_anchor0_end]) - 1) * 3 + 1, 1))
