exports[`semantic query validation and grouping > returns long pivot rows with a hard 50-column-tuple cap and a truncation signal 1`] = `
"WITH [__df_aggregates] AS (
  SELECT [d0].[category] AS [a0],
    [d1].[region] AS [a1],
    [d2].[segment] AS [a2],
    SUM(CAST([f].[sales] AS DECIMAL(38, 10))) AS [__df_v0],
    COUNT_BIG(*) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  LEFT JOIN [dw].[dim_customer] AS [d2] ON [f].[customer_key] = [d2].[customer_key]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1 AND [f].[customer_key] <> -1
  GROUP BY [d0].[category], [d1].[region], [d2].[segment]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_v0] AS [__df_d0]
  FROM [__df_aggregates] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[a1],
    [s].[a2],
    [s].[__df_d0] AS [m0]
  FROM [__df_scalar_0] AS [s]
  WHERE [s].[__df_group_count] > 0
),
[__df_ranked] AS (
  SELECT [r].*, DENSE_RANK() OVER (ORDER BY [r].[a1], [r].[a2]) AS [__df_pivot_rank]
  FROM [__df_result] AS [r]
),
[__df_pivot] AS (
  SELECT [r].*, MAX([r].[__df_pivot_rank]) OVER () AS [__df_pivot_total]
  FROM [__df_ranked] AS [r]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[a2], [r].[m0], [r].[__df_pivot_total]
FROM [__df_pivot] AS [r]
WHERE [r].[__df_pivot_rank] <= 50
ORDER BY [r].[a0] ASC, [r].[a1] ASC, [r].[a2] ASC;"
`;
