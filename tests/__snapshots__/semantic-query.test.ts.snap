END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;

