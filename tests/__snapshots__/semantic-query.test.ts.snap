exports[`semantic query expressions and context > compiles YoY and scalar expressions without nested SQL aggregates 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[Year] AS [c0],
    [f].[sales] AS [c1],
    [d0].[Date] AS [c2]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_date] AS [d0] ON [f].[date_key] = [d0].[DateKey]
  WHERE [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], MIN([b].[c2]) AS [__df_start], MAX([b].[c2]) AS [__df_end]
  FROM [__df_base] AS [b]
  GROUP BY [b].[c0]
),
[__df_result] AS (
  SELECT [g].[a0],
    (CASE WHEN ((SELECT COUNT_BIG(*) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL))) > @p0) THEN ROUND(ABS((CASE WHEN (SELECT SUM(CAST([b].[c1] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c2] >= DATEADD(YEAR, -1, [g].[__df_start]) AND [b].[c2] <= DATEADD(YEAR, -1, [g].[__df_end])) IS NULL OR (SELECT SUM(CAST([b].[c1] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c2] >= DATEADD(YEAR, -1, [g].[__df_start]) AND [b].[c2] <= DATEADD(YEAR, -1, [g].[__df_end])) = 0 THEN @p1 ELSE CAST(((SELECT SUM(CAST([b].[c1] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL))) - (SELECT SUM(CAST([b].[c1] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c2] >= DATEADD(YEAR, -1, [g].[__df_start]) AND [b].[c2] <= DATEADD(YEAR, -1, [g].[__df_end]))) AS FLOAT) / NULLIF((SELECT SUM(CAST([b].[c1] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c2] >= DATEADD(YEAR, -1, [g].[__df_start]) AND [b].[c2] <= DATEADD(YEAR, -1, [g].[__df_end])), 0) END)), @p2) ELSE @p3 END) AS [m0]
  FROM [__df_groups] AS [g]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query expressions and context > implements ALL with a correlated pre-aggregation scope independent of that grouping and slicer 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[category] AS [c0],
    [d1].[region] AS [c1],
    [f].[sales] AS [c2]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], [b].[c1] AS [a1], COUNT_BIG(*) AS [__df_group_count]
  FROM [__df_base] AS [b]
  WHERE [b].[c0] = @p0
  GROUP BY [b].[c0], [b].[c1]
),
[__df_result] AS (
  SELECT [g].[a0],
    [g].[a1],
    (CASE WHEN (SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE ([b].[c1] = [g].[a1] OR ([b].[c1] IS NULL AND [g].[a1] IS NULL))) IS NULL OR (SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE ([b].[c1] = [g].[a1] OR ([b].[c1] IS NULL AND [g].[a1] IS NULL))) = 0 THEN NULL ELSE CAST((SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c0] = @p1 AND ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL)) AND ([b].[c1] = [g].[a1] OR ([b].[c1] IS NULL AND [g].[a1] IS NULL))) AS FLOAT) / NULLIF((SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE ([b].[c1] = [g].[a1] OR ([b].[c1] IS NULL AND [g].[a1] IS NULL))), 0) END) AS [m0]
  FROM [__df_groups] AS [g]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC, [r].[a1] ASC;"
`;

exports[`semantic query expressions and context > recomputes time anchors under CALCULATE filters, then removes date restrictions for the shifted range 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[category] AS [c0],
    [d1].[Date] AS [c1],
    [f].[sales] AS [c2],
    [d1].[Year] AS [c3]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_date] AS [d1] ON [f].[date_key] = [d1].[DateKey]
  WHERE [f].[product_key] <> -1 AND [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], MIN([b].[c1]) AS [__df_start], MAX([b].[c1]) AS [__df_end]
  FROM [__df_base] AS [b]
  GROUP BY [b].[c0]
),
[__df_result] AS (
  SELECT [g].[a0],
    (SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL)) AND [b].[c1] >= DATEFROMPARTS(YEAR((SELECT MAX([b].[c1]) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL)) AND ([b].[c3] = @p0))), 1, 1) AND [b].[c1] <= (SELECT MAX([b].[c1]) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL)) AND ([b].[c3] = @p0))) AS [m0]
  FROM [__df_groups] AS [g]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query expressions and context > uses a preaggregation scope when CALCULATE replaces a grouping or slicer column 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[category] AS [c0],
    [f].[sales] AS [c1]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  WHERE [f].[product_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], COUNT_BIG(*) AS [__df_group_count]
  FROM [__df_base] AS [b]
  WHERE [b].[c0] = @p0
  GROUP BY [b].[c0]
),
[__df_result] AS (
  SELECT [g].[a0],
    (SELECT SUM(CAST(CASE WHEN ([b].[c0] = @p1) THEN [b].[c1] END AS DECIMAL(38, 10))) FROM [__df_base] AS [b]) AS [m0]
  FROM [__df_groups] AS [g]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query expressions and context > uses conditional aggregation for joined CALCULATE filters with every literal bound 1`] = `
"WITH [__df_result] AS (
  SELECT [d1].[region] AS [a0],
    SUM(CAST(CASE WHEN ([d0].[category] IN (@p0, @p1)) THEN [f].[sales] END AS DECIMAL(38, 10))) AS [m0],
    COUNT_BIG(*) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1
  GROUP BY [d1].[region]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query injection and filter boundaries > compiles capped distinct values and counts using the same safe model joins 1`] = `
"SELECT TOP (@__df_limit) [d0].[category] AS [value], COUNT_BIG(*) AS [count]
FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
WHERE [f].[product_key] <> -1
GROUP BY [d0].[category]
ORDER BY [count] DESC, [value] ASC;"
`;

exports[`semantic query validation and grouping > compiles a three-dimension grouped query with deterministic selected ordering and Top N 1`] = `
"WITH [__df_result] AS (
  SELECT [d0].[category] AS [a0],
    [d1].[region] AS [a1],
    [d2].[segment] AS [a2],
    SUM(CAST([f].[sales] AS DECIMAL(38, 10))) AS [m0],
    COUNT_BIG(*) AS [m1],
    COUNT_BIG(*) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  LEFT JOIN [dw].[dim_customer] AS [d2] ON [f].[customer_key] = [d2].[customer_key]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1 AND [f].[customer_key] <> -1
  GROUP BY [d0].[category], [d1].[region], [d2].[segment]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[a2], [r].[m0], [r].[m1]
FROM [__df_result] AS [r]
ORDER BY [r].[m0] DESC, [r].[a1] ASC;"
`;

exports[`semantic query validation and grouping > compiles no-group totals with one aggregate row and no unreferenced dimension joins 1`] = `
"WITH [__df_result] AS (
  SELECT SUM(CAST([f].[sales] AS DECIMAL(38, 10))) AS [m0],
    COUNT_BIG(*) AS [m1],
    COUNT_BIG(*) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
)
SELECT TOP (@__df_limit) [r].[m0], [r].[m1]
FROM [__df_result] AS [r];"
`;

