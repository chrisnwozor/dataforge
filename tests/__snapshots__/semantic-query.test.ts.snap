exports[`semantic query expressions and context > compiles YoY and scalar expressions without nested SQL aggregates 1`] = `
"SET NOCOUNT ON;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_scope_0];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
BEGIN TRY
SELECT [d0].[Year] AS [c0],
    [f].[sales] AS [c1],
    [d0].[Date] AS [c2],
    [f].[fact_key] AS [c3],
    [f].[date_key] AS [c4],
    [d0].[DateKey] AS [c5],
  DENSE_RANK() OVER (ORDER BY [d0].[Year]) AS [__df_k0],
  [d0].[Date] AS [__df_date]
INTO [#df_base]
FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_date] AS [d0] ON [f].[date_key] = [d0].[DateKey]
WHERE [f].[date_key] <> -1;
CREATE CLUSTERED INDEX [ix_df_base_groups] ON [#df_base] ([__df_k0]);
SELECT GROUPING_ID([b].[__df_k0], [b].[__df_date]) AS [__df_grain],
  [b].[__df_k0],
  [b].[__df_date],
  MAX([b].[c0]) AS [a0],
  COUNT_BIG(1) AS [__df_v0],
  SUM(CAST([b].[c1] AS DECIMAL(38, 10))) AS [__df_v1],
  SUM(CAST([b].[c1] AS DECIMAL(38, 10))) AS [__df_v2],
  MIN([b].[__df_date]) AS [__df_anchor0_start],
  MAX([b].[__df_date]) AS [__df_anchor0_end],
  COUNT_BIG(1) AS [__df_group_count]
INTO [#df_agg]
FROM [#df_base] AS [b]
GROUP BY GROUPING SETS (([b].[__df_k0]), ([b].[__df_date]));
CREATE CLUSTERED INDEX [ix_df_agg_grain] ON [#df_agg] ([__df_grain], [__df_date], [__df_k0]);
SELECT ROW_NUMBER() OVER (ORDER BY [a].[__df_k0]) AS [__df_gid], [a].*
INTO [#df_groups]
FROM [#df_agg] AS [a]
WHERE [a].[__df_grain] = 1;
CREATE UNIQUE CLUSTERED INDEX [ix_df_groups_id] ON [#df_groups] ([__df_gid]);
SELECT [g].[__df_gid], SUM([d].[__df_v2]) AS [__df_v2]
INTO [#df_scope_0]
FROM [#df_groups] AS [g]
LEFT JOIN [#df_agg] AS [a] ON [a].[__df_grain] = 1 AND [a].[__df_k0] = [g].[__df_k0]
LEFT JOIN [#df_agg] AS [d] ON [d].[__df_grain] = 2 AND 1 = 1 AND [d].[__df_date] >= DATEADD(YEAR, -1, [a].[__df_anchor0_start]) AND [d].[__df_date] <= DATEADD(YEAR, -1, [a].[__df_anchor0_end])
GROUP BY [g].[__df_gid];
CREATE UNIQUE CLUSTERED INDEX [ix_df_scope_0] ON [#df_scope_0] ([__df_gid]);
SELECT [g].[a0],
  [__df_d3].[v] AS [m0]
INTO [#df_result]
FROM [#df_groups] AS [g]
LEFT JOIN [#df_scope_0] AS [t0] ON [t0].[__df_gid] = [g].[__df_gid]
CROSS APPLY (VALUES ([g].[__df_v0])) AS [__df_d0] ([v])
CROSS APPLY (VALUES ([g].[__df_v1])) AS [__df_d1] ([v])
CROSS APPLY (VALUES ([t0].[__df_v2])) AS [__df_d2] ([v])
CROSS APPLY (VALUES ((CASE WHEN ([__df_d0].[v] > @p0) THEN ROUND(ABS((CASE WHEN NULLIF([__df_d2].[v], 0) IS NULL THEN @p1 ELSE (CAST(([__df_d1].[v] - [__df_d2].[v]) AS FLOAT) / NULLIF([__df_d2].[v], 0)) END)), @p2) ELSE NULL END))) AS [__df_d3] ([v])
WHERE [g].[__df_group_count] > 0;
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [#df_result] AS [r]
ORDER BY [r].[a0] ASC;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_scope_0];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_scope_0];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;

exports[`semantic query expressions and context > implements additive ALL from shared aggregates before filtering visible groups 1`] = `
"SET NOCOUNT ON;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_totals];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
BEGIN TRY
SELECT [d0].[category] AS [c0],
    [d1].[region] AS [c1],
    [f].[sales] AS [c2],
    [f].[fact_key] AS [c3],
    [f].[product_key] AS [c4],
    [d0].[product_key] AS [c5],
    [f].[region_key] AS [c6],
    [d1].[region_key] AS [c7],
  DENSE_RANK() OVER (ORDER BY [d0].[category]) AS [__df_k0],
  DENSE_RANK() OVER (ORDER BY [d1].[region]) AS [__df_k1]
INTO [#df_base]
FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1;
CREATE CLUSTERED INDEX [ix_df_base_groups] ON [#df_base] ([__df_k0], [__df_k1]);
SELECT GROUPING_ID([b].[__df_k0], [b].[__df_k1]) AS [__df_grain],
  [b].[__df_k0],
  [b].[__df_k1],
  MAX([b].[c0]) AS [a0],
  MAX([b].[c1]) AS [a1],
  SUM(CAST(CASE WHEN [b].[c0] = @p0 THEN [b].[c2] END AS DECIMAL(38, 10))) AS [__df_v0],
  SUM(CAST([b].[c2] AS DECIMAL(38, 10))) AS [__df_v1],
  COUNT_BIG(CASE WHEN [b].[c0] = @p1 THEN 1 END) AS [__df_group_count]
INTO [#df_agg]
FROM [#df_base] AS [b]
GROUP BY GROUPING SETS (([b].[__df_k0], [b].[__df_k1]));
CREATE CLUSTERED INDEX [ix_df_agg_grain] ON [#df_agg] ([__df_grain], [__df_k0], [__df_k1]);
SELECT ROW_NUMBER() OVER (ORDER BY [a].[__df_k0], [a].[__df_k1]) AS [__df_gid], [a].*
INTO [#df_groups]
FROM [#df_agg] AS [a]
WHERE [a].[__df_grain] = 0;
CREATE UNIQUE CLUSTERED INDEX [ix_df_groups_id] ON [#df_groups] ([__df_gid]);
SELECT [g].*, SUM([g].[__df_v1]) OVER (PARTITION BY [g].[__df_k1]) AS [__df_w0]
INTO [#df_totals]
FROM [#df_groups] AS [g];
SELECT [g].[a0],
  [g].[a1],
  [__df_d2].[v] AS [m0]
INTO [#df_result]
FROM [#df_totals] AS [g]

CROSS APPLY (VALUES ([g].[__df_v0])) AS [__df_d0] ([v])
CROSS APPLY (VALUES ([g].[__df_w0])) AS [__df_d1] ([v])
CROSS APPLY (VALUES ((CAST([__df_d0].[v] AS FLOAT) / NULLIF([__df_d1].[v], 0)))) AS [__df_d2] ([v])
WHERE [g].[__df_group_count] > 0;
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[m0]
FROM [#df_result] AS [r]
ORDER BY [r].[a0] ASC, [r].[a1] ASC;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_totals];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_totals];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;

