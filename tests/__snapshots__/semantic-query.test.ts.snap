INTO [#df_agg]
FROM [#df_base] AS [b]
GROUP BY GROUPING SETS (([b].[__df_k0]));
CREATE CLUSTERED INDEX [ix_df_agg_grain] ON [#df_agg] ([__df_grain], [__df_k0]);
SELECT ROW_NUMBER() OVER (ORDER BY [a].[__df_k0]) AS [__df_gid], [a].*
INTO [#df_groups]
FROM [#df_agg] AS [a]
WHERE [a].[__df_grain] = 0;
CREATE UNIQUE CLUSTERED INDEX [ix_df_groups_id] ON [#df_groups] ([__df_gid]);
SELECT [g].*, SUM([g].[__df_v0]) OVER () AS [__df_w0]
INTO [#df_totals]
FROM [#df_groups] AS [g];
SELECT [g].[a0],
  [__df_d1].[v] AS [m0]
INTO [#df_result]
FROM [#df_totals] AS [g]

CROSS APPLY (VALUES ([g].[__df_w0])) AS [__df_d0] ([v])
CROSS APPLY (VALUES ([__df_d0].[v])) AS [__df_d1] ([v])
WHERE [g].[__df_group_count] > 0;
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [#df_result] AS [r]
ORDER BY [r].[a0] ASC;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_totals];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_totals];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;

exports[`semantic query expressions and context > uses conditional aggregation for joined CALCULATE filters with every literal bound 1`] = `
"SET NOCOUNT ON;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
BEGIN TRY
SELECT [d1].[region] AS [c0],
    [f].[sales] AS [c1],
    [d0].[category] AS [c2],
    [f].[fact_key] AS [c3],
    [f].[product_key] AS [c4],
    [d0].[product_key] AS [c5],
    [f].[region_key] AS [c6],
    [d1].[region_key] AS [c7],
  DENSE_RANK() OVER (ORDER BY [d1].[region]) AS [__df_k0]
INTO [#df_base]
FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1;
CREATE CLUSTERED INDEX [ix_df_base_groups] ON [#df_base] ([__df_k0]);
SELECT GROUPING_ID([b].[__df_k0]) AS [__df_grain],
  [b].[__df_k0],
  MAX([b].[c0]) AS [a0],
  SUM(CAST(CASE WHEN ([b].[c2] IN (@p0, @p1)) THEN [b].[c1] END AS DECIMAL(38, 10))) AS [__df_v0],
  COUNT_BIG(1) AS [__df_group_count]
INTO [#df_agg]
FROM [#df_base] AS [b]
GROUP BY GROUPING SETS (([b].[__df_k0]));
CREATE CLUSTERED INDEX [ix_df_agg_grain] ON [#df_agg] ([__df_grain], [__df_k0]);
SELECT ROW_NUMBER() OVER (ORDER BY [a].[__df_k0]) AS [__df_gid], [a].*
INTO [#df_groups]
FROM [#df_agg] AS [a]
WHERE [a].[__df_grain] = 0;
CREATE UNIQUE CLUSTERED INDEX [ix_df_groups_id] ON [#df_groups] ([__df_gid]);
SELECT [g].[a0],
  [__df_d1].[v] AS [m0]
INTO [#df_result]
FROM [#df_groups] AS [g]

CROSS APPLY (VALUES ([g].[__df_v0])) AS [__df_d0] ([v])
CROSS APPLY (VALUES ([__df_d0].[v])) AS [__df_d1] ([v])
WHERE [g].[__df_group_count] > 0;
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [#df_result] AS [r]
ORDER BY [r].[a0] ASC;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;

exports[`semantic query injection and filter boundaries > compiles capped distinct values and counts using the same safe model joins 1`] = `
"SET NOCOUNT ON;
DROP TABLE IF EXISTS [#df_base];
BEGIN TRY
SELECT [d0].[category] AS [c0],
    [f].[product_key] AS [c1],
    [d0].[product_key] AS [c2], DENSE_RANK() OVER (ORDER BY [d0].[category]) AS [__df_k0] INTO [#df_base] FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key] WHERE [f].[product_key] <> -1;
CREATE CLUSTERED INDEX [ix_df_base_groups] ON [#df_base] ([__df_k0]);
SELECT TOP (@__df_limit) [b].[c0] AS [value], COUNT_BIG(*) AS [count]
FROM [#df_base] AS [b]
GROUP BY [b].[c0]
ORDER BY [count] DESC, [value] ASC;
DROP TABLE IF EXISTS [#df_base];
END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;

exports[`semantic query validation and grouping > compiles a three-dimension grouped query with deterministic selected ordering and Top N 1`] = `
"SET NOCOUNT ON;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
BEGIN TRY
SELECT [d0].[category] AS [c0],
    [d1].[region] AS [c1],
    [d2].[segment] AS [c2],
    [f].[sales] AS [c3],
    [f].[fact_key] AS [c4],
    [f].[product_key] AS [c5],
    [d0].[product_key] AS [c6],
    [f].[region_key] AS [c7],
    [d1].[region_key] AS [c8],
    [f].[customer_key] AS [c9],
    [d2].[customer_key] AS [c10],
  DENSE_RANK() OVER (ORDER BY [d0].[category]) AS [__df_k0],
  DENSE_RANK() OVER (ORDER BY [d1].[region]) AS [__df_k1],
  DENSE_RANK() OVER (ORDER BY [d2].[segment]) AS [__df_k2]
INTO [#df_base]
FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  LEFT JOIN [dw].[dim_customer] AS [d2] ON [f].[customer_key] = [d2].[customer_key]
WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1 AND [f].[customer_key] <> -1;
CREATE CLUSTERED INDEX [ix_df_base_groups] ON [#df_base] ([__df_k0], [__df_k1], [__df_k2]);
SELECT GROUPING_ID([b].[__df_k0], [b].[__df_k1], [b].[__df_k2]) AS [__df_grain],
  [b].[__df_k0],
  [b].[__df_k1],
  [b].[__df_k2],
  MAX([b].[c0]) AS [a0],
  MAX([b].[c1]) AS [a1],
  MAX([b].[c2]) AS [a2],
  SUM(CAST([b].[c3] AS DECIMAL(38, 10))) AS [__df_v0],
  COUNT_BIG(1) AS [__df_v1],
  COUNT_BIG(1) AS [__df_group_count]
INTO [#df_agg]
FROM [#df_base] AS [b]
GROUP BY GROUPING SETS (([b].[__df_k0], [b].[__df_k1], [b].[__df_k2]));
CREATE CLUSTERED INDEX [ix_df_agg_grain] ON [#df_agg] ([__df_grain], [__df_k0], [__df_k1], [__df_k2]);
SELECT ROW_NUMBER() OVER (ORDER BY [a].[__df_k0], [a].[__df_k1], [a].[__df_k2]) AS [__df_gid], [a].*
INTO [#df_groups]
FROM [#df_agg] AS [a]
WHERE [a].[__df_grain] = 0;
CREATE UNIQUE CLUSTERED INDEX [ix_df_groups_id] ON [#df_groups] ([__df_gid]);
SELECT [g].[a0],
  [g].[a1],
  [g].[a2],
  [__df_d0].[v] AS [m0],
  [__df_d1].[v] AS [m1]
INTO [#df_result]
FROM [#df_groups] AS [g]

CROSS APPLY (VALUES ([g].[__df_v0])) AS [__df_d0] ([v])
CROSS APPLY (VALUES ([g].[__df_v1])) AS [__df_d1] ([v])
WHERE [g].[__df_group_count] > 0;
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[a2], [r].[m0], [r].[m1]
FROM [#df_result] AS [r]
ORDER BY [r].[m0] DESC, [r].[a1] ASC;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;

exports[`semantic query validation and grouping > compiles no-group totals with one aggregate row and no unreferenced dimension joins 1`] = `
"SET NOCOUNT ON;
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
BEGIN TRY
SELECT [f].[sales] AS [c0],
    [f].[fact_key] AS [c1],
  CAST(0 AS INT) AS [__df_k0]
INTO [#df_base]
FROM [dw].[fact_sales] AS [f];
CREATE CLUSTERED INDEX [ix_df_base_groups] ON [#df_base] ([__df_k0]);
SELECT CAST(0 AS INT) AS [__df_grain],
  SUM(CAST([b].[c0] AS DECIMAL(38, 10))) AS [__df_v0],
  COUNT_BIG(1) AS [__df_v1],
  COUNT_BIG(1) AS [__df_group_count]
INTO [#df_agg]
FROM [#df_base] AS [b]
GROUP BY GROUPING SETS (());
CREATE CLUSTERED INDEX [ix_df_agg_grain] ON [#df_agg] ([__df_grain]);
