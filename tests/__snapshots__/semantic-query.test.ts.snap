  FROM [__df_scalar_0] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[a1],
    [s].[__df_d1] AS [m0]
  FROM [__df_scalar_1] AS [s]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC, [r].[a1] ASC;"
`;

exports[`semantic query expressions and context > compiles YTD with calendar range joins and preserves non-date groups 1`] = `
"WITH [__df_base] AS (
  SELECT [d2].[Year] AS [c0],
    [d0].[category] AS [c1],
    [d1].[region] AS [c2],
    [d2].[Date] AS [c3],
    [f].[sales] AS [c4]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  LEFT JOIN [dw].[dim_date] AS [d2] ON [f].[date_key] = [d2].[DateKey]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1 AND [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], [b].[c1] AS [a1], MIN([b].[c3]) AS [__df_start], MAX([b].[c3]) AS [__df_end]
  FROM [__df_base] AS [b]
  WHERE [b].[c0] = @p1 AND [b].[c2] = @p2
  GROUP BY [b].[c0], [b].[c1]
),
[__df_aggregates] AS (
  SELECT [g].*,
    (SELECT SUM(CAST([b].[c4] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c2] = @p0 AND ([b].[c1] = [g].[a1] OR ([b].[c1] IS NULL AND [g].[a1] IS NULL)) AND [b].[c3] >= DATEFROMPARTS(YEAR([g].[__df_end]), 1, 1) AND [b].[c3] <= [g].[__df_end]) AS [__df_v0]
  FROM [__df_groups] AS [g]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_v0] AS [__df_d0]
  FROM [__df_aggregates] AS [s]
