exports[`semantic query validation and grouping > returns long pivot rows with a hard 50-column-tuple cap and a truncation signal 1`] = `
"SET NOCOUNT ON;
DROP TABLE IF EXISTS [#df_pivot];
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
BEGIN TRY
SELECT [d0].[category] AS [c0],
    [d1].[region] AS [c1],
    [d2].[segment] AS [c2],
    [f].[sales] AS [c3],
    [f].[fact_key] AS [c4],
    [f].[product_key] AS [c5],
    [d0].[product_key] AS [c6],
    [f].[region_key] AS [c7],
    [d1].[region_key] AS [c8],
    [f].[customer_key] AS [c9],
    [d2].[customer_key] AS [c10],
  DENSE_RANK() OVER (ORDER BY [d0].[category]) AS [__df_k0],
  DENSE_RANK() OVER (ORDER BY [d1].[region]) AS [__df_k1],
  DENSE_RANK() OVER (ORDER BY [d2].[segment]) AS [__df_k2]
INTO [#df_base]
FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  LEFT JOIN [dw].[dim_customer] AS [d2] ON [f].[customer_key] = [d2].[customer_key]
WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1 AND [f].[customer_key] <> -1;
CREATE CLUSTERED INDEX [ix_df_base_groups] ON [#df_base] ([__df_k0], [__df_k1], [__df_k2]);
SELECT GROUPING_ID([b].[__df_k0], [b].[__df_k1], [b].[__df_k2]) AS [__df_grain],
  [b].[__df_k0],
  [b].[__df_k1],
  [b].[__df_k2],
  MAX([b].[c0]) AS [a0],
  MAX([b].[c1]) AS [a1],
  MAX([b].[c2]) AS [a2],
  SUM(CAST([b].[c3] AS DECIMAL(38, 10))) AS [__df_v0],
  COUNT_BIG(1) AS [__df_group_count]
INTO [#df_agg]
FROM [#df_base] AS [b]
GROUP BY GROUPING SETS (([b].[__df_k0], [b].[__df_k1], [b].[__df_k2]));
CREATE CLUSTERED INDEX [ix_df_agg_grain] ON [#df_agg] ([__df_grain], [__df_k0], [__df_k1], [__df_k2]);
SELECT ROW_NUMBER() OVER (ORDER BY [a].[__df_k0], [a].[__df_k1], [a].[__df_k2]) AS [__df_gid], [a].*
INTO [#df_groups]
FROM [#df_agg] AS [a]
WHERE [a].[__df_grain] = 0;
CREATE UNIQUE CLUSTERED INDEX [ix_df_groups_id] ON [#df_groups] ([__df_gid]);
SELECT [g].[a0],
  [g].[a1],
  [g].[a2],
  [__df_d0].[v] AS [m0], DENSE_RANK() OVER (ORDER BY [g].[a1], [g].[a2]) AS [__df_pivot_rank]
INTO [#df_result]
FROM [#df_groups] AS [g]

CROSS APPLY (VALUES ([g].[__df_v0])) AS [__df_d0] ([v])
WHERE [g].[__df_group_count] > 0;
SELECT [r].*, MAX([r].[__df_pivot_rank]) OVER () AS [__df_pivot_total] INTO [#df_pivot] FROM [#df_result] AS [r];
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[a2], [r].[m0], [r].[__df_pivot_total]
FROM [#df_pivot] AS [r]
WHERE [r].[__df_pivot_rank] <= 50
ORDER BY [r].[a0] ASC, [r].[a1] ASC, [r].[a2] ASC;
DROP TABLE IF EXISTS [#df_pivot];
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
END TRY
BEGIN CATCH
DROP TABLE IF EXISTS [#df_pivot];
DROP TABLE IF EXISTS [#df_result];
DROP TABLE IF EXISTS [#df_groups];
DROP TABLE IF EXISTS [#df_agg];
DROP TABLE IF EXISTS [#df_base];
THROW;
END CATCH;"
`;
