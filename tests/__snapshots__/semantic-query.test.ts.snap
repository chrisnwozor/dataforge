exports[`semantic query expressions and context > compiles YoY and scalar expressions without nested SQL aggregates 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[Year] AS [c0],
    [f].[sales] AS [c1],
    [d0].[Date] AS [c2]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_date] AS [d0] ON [f].[date_key] = [d0].[DateKey]
  WHERE [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], MIN([b].[c2]) AS [__df_start], MAX([b].[c2]) AS [__df_end]
  FROM [__df_base] AS [b]
  GROUP BY [b].[c0]
),
[__df_aggregates] AS (
  SELECT [g].*,
    (SELECT COUNT_BIG(*) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL))) AS [__df_v0],
    (SELECT SUM(CAST([b].[c1] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL))) AS [__df_v1],
    (SELECT SUM(CAST([b].[c1] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE [b].[c2] >= DATEADD(YEAR, -1, [g].[__df_start]) AND [b].[c2] <= DATEADD(YEAR, -1, [g].[__df_end])) AS [__df_v2]
  FROM [__df_groups] AS [g]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_v0] AS [__df_d0]
  FROM [__df_aggregates] AS [s]
),
[__df_scalar_1] AS (
  SELECT [s].*, [s].[__df_v1] AS [__df_d1]
  FROM [__df_scalar_0] AS [s]
),
[__df_scalar_2] AS (
  SELECT [s].*, [s].[__df_v2] AS [__df_d2]
  FROM [__df_scalar_1] AS [s]
),
[__df_scalar_3] AS (
  SELECT [s].*, (CASE WHEN ([s].[__df_d0] > @p0) THEN ROUND(ABS((CASE WHEN [s].[__df_d2] IS NULL OR [s].[__df_d2] = 0 THEN @p1 ELSE CAST(([s].[__df_d1] - [s].[__df_d2]) AS FLOAT) / NULLIF([s].[__df_d2], 0) END)), @p2) ELSE @p3 END) AS [__df_d3]
  FROM [__df_scalar_2] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[__df_d3] AS [m0]
  FROM [__df_scalar_3] AS [s]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query expressions and context > implements additive ALL from shared aggregates before filtering visible groups 1`] = `
"WITH [__df_aggregates] AS (
  SELECT [d0].[category] AS [a0],
    [d1].[region] AS [a1],
    SUM(CAST(CASE WHEN [d0].[category] = @p0 THEN [f].[sales] END AS DECIMAL(38, 10))) AS [__df_v0],
    SUM(CAST([f].[sales] AS DECIMAL(38, 10))) AS [__df_v1],
    COUNT_BIG(CASE WHEN [d0].[category] = @p1 THEN 1 END) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1
  GROUP BY [d0].[category], [d1].[region]
),
[__df_windows] AS (
  SELECT [s].*, SUM([s].[__df_v1]) OVER (PARTITION BY [s].[a1]) AS [__df_w0]
  FROM [__df_aggregates] AS [s]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_v0] AS [__df_d0]
  FROM [__df_windows] AS [s]
),
[__df_scalar_1] AS (
  SELECT [s].*, [s].[__df_w0] AS [__df_d1]
  FROM [__df_scalar_0] AS [s]
),
[__df_scalar_2] AS (
  SELECT [s].*, (CASE WHEN [s].[__df_d1] IS NULL OR [s].[__df_d1] = 0 THEN NULL ELSE CAST([s].[__df_d0] AS FLOAT) / NULLIF([s].[__df_d1], 0) END) AS [__df_d2]
  FROM [__df_scalar_1] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[a1],
    [s].[__df_d2] AS [m0]
  FROM [__df_scalar_2] AS [s]
  WHERE [s].[__df_group_count] > 0
)
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC, [r].[a1] ASC;"
`;

exports[`semantic query expressions and context > recomputes time anchors under CALCULATE filters, then removes date restrictions for the shifted range 1`] = `
"WITH [__df_base] AS (
  SELECT [d0].[category] AS [c0],
    [d1].[Date] AS [c1],
    [f].[sales] AS [c2],
    [d1].[Year] AS [c3]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_date] AS [d1] ON [f].[date_key] = [d1].[DateKey]
  WHERE [f].[product_key] <> -1 AND [f].[date_key] <> -1
),
[__df_groups] AS (
  SELECT [b].[c0] AS [a0], MIN([b].[c1]) AS [__df_start], MAX([b].[c1]) AS [__df_end]
  FROM [__df_base] AS [b]
  GROUP BY [b].[c0]
),
[__df_aggregates] AS (
  SELECT [g].*,
    (SELECT SUM(CAST([b].[c2] AS DECIMAL(38, 10))) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL)) AND [b].[c1] >= DATEFROMPARTS(YEAR((SELECT MAX([b].[c1]) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL)) AND ([b].[c3] = @p0))), 1, 1) AND [b].[c1] <= (SELECT MAX([b].[c1]) FROM [__df_base] AS [b] WHERE ([b].[c0] = [g].[a0] OR ([b].[c0] IS NULL AND [g].[a0] IS NULL)) AND ([b].[c3] = @p0))) AS [__df_v0]
  FROM [__df_groups] AS [g]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_v0] AS [__df_d0]
  FROM [__df_aggregates] AS [s]
),
[__df_scalar_1] AS (
  SELECT [s].*, [s].[__df_d0] AS [__df_d1]
  FROM [__df_scalar_0] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[__df_d1] AS [m0]
  FROM [__df_scalar_1] AS [s]
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query expressions and context > uses a shared conditional aggregate and window when CALCULATE replaces a grouping or slicer 1`] = `
"WITH [__df_aggregates] AS (
  SELECT [d0].[category] AS [a0],
    SUM(CAST(CASE WHEN ([d0].[category] = @p0) THEN [f].[sales] END AS DECIMAL(38, 10))) AS [__df_v0],
    COUNT_BIG(CASE WHEN [d0].[category] = @p1 THEN 1 END) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  WHERE [f].[product_key] <> -1
  GROUP BY [d0].[category]
),
[__df_windows] AS (
  SELECT [s].*, SUM([s].[__df_v0]) OVER () AS [__df_w0]
  FROM [__df_aggregates] AS [s]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_w0] AS [__df_d0]
  FROM [__df_windows] AS [s]
),
[__df_scalar_1] AS (
  SELECT [s].*, [s].[__df_d0] AS [__df_d1]
  FROM [__df_scalar_0] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[__df_d1] AS [m0]
  FROM [__df_scalar_1] AS [s]
  WHERE [s].[__df_group_count] > 0
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query expressions and context > uses conditional aggregation for joined CALCULATE filters with every literal bound 1`] = `
"WITH [__df_aggregates] AS (
  SELECT [d1].[region] AS [a0],
    SUM(CAST(CASE WHEN ([d0].[category] IN (@p0, @p1)) THEN [f].[sales] END AS DECIMAL(38, 10))) AS [__df_v0],
    COUNT_BIG(*) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1
  GROUP BY [d1].[region]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_v0] AS [__df_d0]
  FROM [__df_aggregates] AS [s]
),
[__df_scalar_1] AS (
  SELECT [s].*, [s].[__df_d0] AS [__df_d1]
  FROM [__df_scalar_0] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[__df_d1] AS [m0]
  FROM [__df_scalar_1] AS [s]
  WHERE [s].[__df_group_count] > 0
)
SELECT TOP (@__df_limit) [r].[a0], [r].[m0]
FROM [__df_result] AS [r]
ORDER BY [r].[a0] ASC;"
`;

exports[`semantic query injection and filter boundaries > compiles capped distinct values and counts using the same safe model joins 1`] = `
"SELECT TOP (@__df_limit) [d0].[category] AS [value], COUNT_BIG(*) AS [count]
FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
WHERE [f].[product_key] <> -1
GROUP BY [d0].[category]
ORDER BY [count] DESC, [value] ASC;"
`;

exports[`semantic query validation and grouping > compiles a three-dimension grouped query with deterministic selected ordering and Top N 1`] = `
"WITH [__df_aggregates] AS (
  SELECT [d0].[category] AS [a0],
    [d1].[region] AS [a1],
    [d2].[segment] AS [a2],
    SUM(CAST([f].[sales] AS DECIMAL(38, 10))) AS [__df_v0],
    COUNT_BIG(*) AS [__df_v1],
    COUNT_BIG(*) AS [__df_group_count]
  FROM [dw].[fact_sales] AS [f]
  LEFT JOIN [dw].[dim_product] AS [d0] ON [f].[product_key] = [d0].[product_key]
  LEFT JOIN [dw].[dim_region] AS [d1] ON [f].[region_key] = [d1].[region_key]
  LEFT JOIN [dw].[dim_customer] AS [d2] ON [f].[customer_key] = [d2].[customer_key]
  WHERE [f].[product_key] <> -1 AND [f].[region_key] <> -1 AND [f].[customer_key] <> -1
  GROUP BY [d0].[category], [d1].[region], [d2].[segment]
),
[__df_scalar_0] AS (
  SELECT [s].*, [s].[__df_v0] AS [__df_d0]
  FROM [__df_aggregates] AS [s]
),
[__df_scalar_1] AS (
  SELECT [s].*, [s].[__df_v1] AS [__df_d1]
  FROM [__df_scalar_0] AS [s]
),
[__df_result] AS (
  SELECT [s].[a0],
    [s].[a1],
    [s].[a2],
    [s].[__df_d0] AS [m0],
    [s].[__df_d1] AS [m1]
  FROM [__df_scalar_1] AS [s]
  WHERE [s].[__df_group_count] > 0
)
SELECT TOP (@__df_limit) [r].[a0], [r].[a1], [r].[a2], [r].[m0], [r].[m1]
FROM [__df_result] AS [r]
ORDER BY [r].[m0] DESC, [r].[a1] ASC;"
`;

