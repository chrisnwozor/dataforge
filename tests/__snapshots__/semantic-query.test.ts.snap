INTO [#df_groups]
FROM [#df_agg] AS [a]
WHERE [a].[__df_grain] = 1;
CREATE UNIQUE CLUSTERED INDEX [ix_df_groups_id] ON [#df_groups] ([__df_gid]);
SELECT [g].[__df_gid], SUM([d].[__df_v0]) AS [__df_v0]
INTO [#df_scope_0]
FROM [#df_groups] AS [g]
LEFT JOIN [#df_agg] AS [a] ON [a].[__df_grain] = 1 AND [a].[__df_k0] = [g].[__df_k0] AND [a].[__df_k1] = [g].[__df_k1]
LEFT JOIN [#df_agg] AS [d] ON [d].[__df_grain] = 4 AND [d].[__df_k1] = [g].[__df_k1] AND [d].[__df_date] >= DATEADD(YEAR, -1, [a].[__df_anchor0_start]) AND [d].[__df_date] <= DATEADD(YEAR, -1, [a].[__df_anchor0_end])
GROUP BY [g].[__df_gid];
